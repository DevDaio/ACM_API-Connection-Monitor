# ─── ACM API Connection Monitor ───
# Alle IPs/Ports/Verbindungen werden hier zentral konfiguriert.
# Das Backend liest zur Laufzeit, Vite zur Build-/Dev-Zeit.
#
# → Wird bei Deployment via `EnvironmentFile=` geladen (systemd).
#   Setze DATABASE_URL auf den RDS-Endpoint, nicht localhost!

POSTGRES_USER=postgres                    # docker-compose (lokal) — für RDS irrelevant
POSTGRES_PASSWORD=admin123!              # docker-compose (lokal) — für RDS irrelevant
POSTGRES_DB=database-acm

DATABASE_URL=postgres://postgres:admin123!@localhost:5432/database-acm   # <-- HIER: RDS-Endpoint eintragen!

BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000

RUST_LOG=info

FRONTEND_PORT=8080
API_PROXY_TARGET=http://localhost:3000

VITE_API_URL=/acm
