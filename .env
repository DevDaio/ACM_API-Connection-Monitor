# ─── ACM API Connection Monitor — Backend ───
# Wird via `EnvironmentFile=` von systemd geladen.
# Setze DATABASE_URL auf den RDS-Endpoint, nicht localhost!

# Datenbank-Zugang (für docker-compose und lokale Entwicklung)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin123!
POSTGRES_DB=database_acm

DATABASE_URL=postgres://postgres:admin123!@localhost:5432/database_acm

BACKEND_HOST=0.0.0.0
BACKEND_PORT=3000

RUST_LOG=info
