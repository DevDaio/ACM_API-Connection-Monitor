{
  "name": "acm-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",          // "type": "module" = ES-Modules (import/export statt require)
  "scripts": {
    "dev": "vite",            // Startet Vite-Dev-Server mit HMR
    "build": "vite build",    // Produktions-Build in dist/
    "lint": "eslint .",       // Code-Qualitaetspruefung
    "preview": "vite preview" // Lokale Vorschau des Builds
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",  // Tailwind CSS 4 als Vite-Plugin
    "react": "^19.2.6",             // React 19
    "react-dom": "^19.2.6",         // React DOM (Browser)
    "tailwindcss": "^4.3.0"         // Tailwind CSS 4 – Utility-First-Framework
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",          // ESLint 10 JS-Konfig
    "@types/react": "^19.2.14",       // TypeScript-Typen fuer React (wird auch in JSX verwendet)
    "@types/react-dom": "^19.2.3",    // TypeScript-Typen fuer React DOM
    "@vitejs/plugin-react": "^6.0.1", // Vite-React-Plugin (JSX-Transform, Fast-Refresh)
    "eslint": "^10.3.0",              // Linter
    "eslint-plugin-react-hooks": "^7.1.1",   // ESLint-Regeln fuer React Hooks
    "eslint-plugin-react-refresh": "^0.5.2", // ESLint-Regeln fuer Fast-Refresh
    "globals": "^17.6.0",             // Globale JS-Umgebungen (browser, node, etc.)
    "vite": "^8.0.12"                 // Vite-Bundler
  }
}
