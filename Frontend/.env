# ─── ACM API Connection Monitor — Frontend ───
# Wird von Vite zur Build-Zeit gelesen (import.meta.env).
# In Production: VITE_API_URL leer lassen → relativer Pfad /acm/...
# EC2-Nginx proxyt /acm/* zum Backend (same-origin, kein CORS nötig).

FRONTEND_PORT=8080

API_PROXY_TARGET=http://localhost:3000
