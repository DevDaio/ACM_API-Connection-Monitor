# ─── ACM API Connection Monitor — Frontend ───
# Wird von Vite zur Build-Zeit gelesen (import.meta.env).
# In Production: VITE_API_URL auf EC2-Public-IP setzen.
# Bei EC2-Stop/Start ändert sich die IP → hier updaten + neu bauen + deployen.

FRONTEND_PORT=8080

# Lokale Entwicklung: Vite-Proxy-Ziel
API_PROXY_TARGET=http://localhost:3000

# Production: API-Basis-URL (EC2 Public IP, Port 3000)
# Nach EC2-Stop/Start aktualisieren!
VITE_API_URL=http://34.255.182.66:3000/acm
